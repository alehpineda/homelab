# Managed by ansible role openobserve. Mode 0600. Contains the root password.
# Root is created from these values on FIRST start only; changing them later
# does not change the stored root user.
ZO_ROOT_USER_EMAIL="{{ _o2_root_email }}"
ZO_ROOT_USER_PASSWORD="{{ _o2_root_password }}"
ZO_DATA_DIR="{{ openobserve_data_dir }}"
ZO_HTTP_PORT="{{ openobserve_http_port }}"
ZO_GRPC_PORT="{{ openobserve_grpc_port }}"
ZO_HTTP_IPV6_ENABLED="false"
ZO_WEB_URL="{{ openobserve_web_url }}"
ZO_TELEMETRY="false"
ZO_COMPACT_DATA_RETENTION_DAYS="{{ openobserve_retention_days }}"
ZO_MEMORY_CACHE_MAX_SIZE="{{ openobserve_memory_cache_max_mb }}"
ZO_MEMORY_CACHE_DATAFUSION_MAX_SIZE="{{ openobserve_datafusion_max_mb }}"
