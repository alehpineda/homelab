#!/bin/sh
# Managed by ansible role alloy (alehpineda/homelab). Do not edit live.
# Grants the alloy user read on the AdGuard querylog and re-applies it after
# AdGuard's startup permcheck (chmod 0700/0600 zeroes the ACL mask). Touches
# only ACL entries and masks on the data dir and querylog.json{,.1}; no-op
# when they are already right.
set -eu
D="{{ alloy_adguard_data_dir }}"
Q="{{ alloy_adguard_querylog }}"

fix() {
  p="$1"; spec="$2"; shift 2
  cur="$(getfacl -cpE "$p" 2>/dev/null)" || return 0
  for want in "$@"; do
    if printf '%s\n' "$cur" | grep -qx "$want"; then continue; fi
    setfacl -m "$spec" "$p"
    logger -t alloy-adguard-acl "re-applied $spec on $p"
    return 0
  done
}

fix "$D" "u:alloy:rx,m::rx,d:u:alloy:r,d:m::r" \
  "user:alloy:r-x" "mask::r-x" "default:user:alloy:r--" "default:mask::r--"
for f in "$Q" "$Q.1"; do
  if [ -f "$f" ]; then
    fix "$f" "u:alloy:r,m::r" "user:alloy:r--" "mask::r--"
  fi
done
