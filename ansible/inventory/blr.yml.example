---
# Copy to inventory/blr.yml (gitignored). Never commit the copy.
#
# Reach BRL over NetBird (100.85.104.18) or LAN (10.10.0.21).
# Placeholder addresses below are examples. Replace example-lxc before use.
#
# SSH port: hosts hardened by alehpineda/ansible-playbooks may listen on 4488.
# Fresh LXCs often still listen on 22. Set ansible_port on each host.

all:
  children:
    pve:
      hosts:
        barbatoslupusrex:
          ansible_host: 100.85.104.18
          ansible_port: 22
    lxc:
      hosts:
        example-lxc:
          ansible_host: 10.10.0.50
          ansible_port: 22
          # ansible_port: 4488  # uncomment only for a guest hardened by ansible-playbooks
        # CT 175. playbooks/ollama.yml targets this host. site.yml does not.
        # Port 22: official Ollama 0.40.15 installer, not an ansible-playbooks harden.
        ollama-blr-lxc:
          ansible_host: 10.10.0.63
          ansible_port: 22
        # Uncomment in the local gitignored copy. Fresh monitoring/Postiz LXCs listen on 22.
        # postiz-blr-lxc:            # CT 169
        #   ansible_host: 10.10.0.69
        #   ansible_port: 22
        # grafana-blr-lxc:           # CT 171
        #   ansible_host: 10.10.0.71
        #   ansible_port: 22
        # CT 172 / 173 / 177. playbooks/logging.yml targets these. site.yml does not.
        prometheus-blr-lxc:
          ansible_host: 10.10.0.72
          ansible_port: 22
        loki-blr-lxc:
          ansible_host: 10.10.0.73
          ansible_port: 22
        openobserve-blr-lxc:
          ansible_host: 10.10.0.77
          ansible_port: 22
        # pve-exporter-blr-lxc:      # CT 174
        #   ansible_host: 10.10.0.74
        #   ansible_port: 22
        # CT 176. playbooks/grokbot-headless.yml targets this host. site.yml does not.
        forge-ws-blr-lxc:
          ansible_host: 10.10.0.76
          ansible_port: 22
          ansible_user: deathscythe
        # CT 182. playbooks/arr.yml targets this host. site.yml does not.
        # Declared, not created until the phase-1 plan is applied.
        # Port 22: fresh LXC, not an ansible-playbooks harden.
        arr-blr-lxc:
          ansible_host: 10.10.0.82
          ansible_port: 22
        # CT 191 / 198. playbooks/dashboards.yml targets these. site.yml does not.
        # Set dashboard_editor_pubkeys here in the local copy (public keys only).
        homepage-blr-lxc:
          ansible_host: 10.10.0.91
          ansible_port: 22
          dashboard_editor_config_file: /opt/homepage/config/services.yaml
          # dashboard_editor_pubkeys: ["ssh-ed25519 AAAA... forge-ct176"]
        homer-blr-lxc:
          ansible_host: 10.10.0.98
          ansible_port: 22
          dashboard_editor_config_file: /opt/homer/assets/config.yml
          # dashboard_editor_pubkeys: ["ssh-ed25519 AAAA... forge-ct176"]
        # CT 250. playbooks/caddy.yml targets this host. site.yml does not.
        # Port 22: Debian 13 Caddy guest, not an ansible-playbooks harden.
        caddy-blr-lxc:
          ansible_host: 10.10.0.250
          ansible_port: 22
    # Proxmox Backup Server. playbooks/pbs.yml targets this group. site.yml does not.
    pbs:
      hosts:
        astarothrinascimento:
          ansible_host: 10.10.0.25
          ansible_port: 22
          ansible_user: grokops
          # Set pbs_grokaudit_pubkeys / pbs_grokops_pubkeys in gitignored host_vars.
    # Oracle VPS. playbooks/host-backups.yml (role gremory_pull_source). Public SSH only;
    # never install NetBird on it.
    gremory:
      hosts:
        vnic-gremory:
          ansible_host: 163.192.206.150
          ansible_user: gremory
          # gremory_pull_source_pubkey: set in gitignored host_vars
    # Console root autologin. Empty until the gitignored copy lists the
    # approved guests (CT 175, CT 182, CT 250). CT 176 is not a member.
    # See ansible/README.md.
    console_autologin:
      hosts: {}
