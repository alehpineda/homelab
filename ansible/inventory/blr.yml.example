---
# Copy to inventory/blr.yml (gitignored). Never commit the copy.
#
# Reach BRL over NetBird (100.85.104.18) or LAN (10.10.0.21).
# Placeholder addresses below are examples. Replace example-lxc before use.
#
# SSH port: hosts hardened by alehpineda/ansible-playbooks may listen on 4488.
# Fresh LXCs often still listen on 22. Set ansible_port on each host.

all:
  children:
    pve:
      hosts:
        barbatoslupusrex:
          ansible_host: 100.85.104.18
          ansible_port: 22
    lxc:
      hosts:
        example-lxc:
          ansible_host: 10.10.0.50
          ansible_port: 22
          # ansible_port: 4488  # uncomment only for a guest hardened by ansible-playbooks
        # CT 175. playbooks/ollama.yml targets this host. site.yml does not.
        # Port 22: official Ollama 0.40.15 installer, not an ansible-playbooks harden.
        ollama-blr-lxc:
          ansible_host: 10.10.0.63
          ansible_port: 22
        # Uncomment postiz in the local gitignored copy. Fresh monitoring/Postiz LXCs listen on 22.
        # postiz-blr-lxc:            # CT 169
        #   ansible_host: 10.10.0.69
        #   ansible_port: 22
        # CT 171. playbooks/logging.yml (alloy_grafana) targets this host.
        grafana-blr-lxc:
          ansible_host: 10.10.0.71
          ansible_port: 22
        # CT 172 / 173 / 177. playbooks/logging.yml targets these. site.yml does not.
        prometheus-blr-lxc:
          ansible_host: 10.10.0.72
          ansible_port: 22
        loki-blr-lxc:
          ansible_host: 10.10.0.73
          ansible_port: 22
        openobserve-blr-lxc:
          ansible_host: 10.10.0.77
          ansible_port: 22
        # CT 178 / 179. playbooks/databases.yml + logging.yml (alloy_postgres /
        # alloy_mariadb) target these. site.yml does not. Declared, not created.
        postgres-blr-lxc:
          ansible_host: 10.10.0.78
          ansible_port: 22
        mariadb-blr-lxc:
          ansible_host: 10.10.0.79
          ansible_port: 22
        # CT 174. playbooks/logging.yml (alloy_pve_exporter) targets this host.
        pve-exporter-blr-lxc:
          ansible_host: 10.10.0.74
          ansible_port: 22
        # CT 176. playbooks/grokbot-headless.yml targets this host. site.yml does not.
        forge-ws-blr-lxc:
          ansible_host: 10.10.0.76
          ansible_port: 22
          ansible_user: deathscythe
        # CT 182. playbooks/arr.yml targets this host. site.yml does not.
        # Declared, not created until the phase-1 plan is applied.
        # Port 22: fresh LXC, not an ansible-playbooks harden.
        arr-blr-lxc:
          ansible_host: 10.10.0.82
          ansible_port: 22
        # CT 184. playbooks/netbird-client.yml targets this host. site.yml does not.
        # Set netbird_client_setup_key_file only for a fresh enroll (key never committed).
        uptimekuma-blr-lxc:
          ansible_host: 10.10.0.84
          ansible_port: 22
          netbird_client_hostname: ct184-uptime-kuma
          # netbird_client_setup_key_file: /home/box/secrets/netbird-setupkey-ct184-kuma
          netbird_client_hosts_pins:
            - {ip: 10.10.0.250, name: jackett.alehpineda.com}
            - {ip: 100.85.100.247, name: crowdsec.alehpineda.com}
        # CT 191 / 192 / 198. playbooks/dashboards.yml targets 191 and 198.
        # site.yml does not. grokops keys come from
        # group_vars/all/bot_ssh_keys.yml (role bot_ssh_keys). Wave 4 log shipping (logging.yml
        # --tags alloy_wave4) also targets these plus CT 176 and CT 165.
        homepage-blr-lxc:
          ansible_host: 10.10.0.91
          ansible_port: 22
          dashboard_editor_config_files:
            - /opt/homepage/config/services.yaml
            - /opt/homepage/config/settings.yaml
            - /opt/homepage/config/widgets.yaml
            - /opt/homepage/config/bookmarks.yaml
            - /opt/homepage/config/proxmox.yaml
        homarr-blr-lxc:  # CT 192
          ansible_host: 10.10.0.92
          ansible_port: 22
        homer-blr-lxc:
          ansible_host: 10.10.0.98
          ansible_port: 22
          dashboard_editor_config_files:
            - /opt/homer/assets/config.yml
        honcho-blr-lxc:  # CT 165
          ansible_host: 10.10.0.65
          ansible_port: 22
        # Wave 2 log shipping (playbooks/logging.yml --tags alloy_wave2). Alloy only.
        jellyfin-blr-lxc:  # CT 180
          ansible_host: 10.10.0.80
          ansible_port: 22
        seerr-blr-lxc:  # CT 183
          ansible_host: 10.10.0.83
          ansible_port: 22
        romm-blr-lxc:  # CT 185
          ansible_host: 10.10.0.85
          ansible_port: 22
        navidrome-blr-lxc:  # CT 186
          ansible_host: 10.10.0.86
          ansible_port: 22
        audiobookshelf-blr-lxc:  # CT 187
          ansible_host: 10.10.0.87
          ansible_port: 22
        bentopdf-blr-lxc:  # CT 193
          ansible_host: 10.10.0.93
          ansible_port: 22
        linkwarden-blr-lxc:  # CT 196
          ansible_host: 10.10.0.96
          ansible_port: 22
        searxng-blr-lxc:  # CT 160
          ansible_host: 10.10.0.60
          ansible_port: 22
        vaultwarden-blr-lxc:  # CT 161
          ansible_host: 10.10.0.61
          ansible_port: 22
        metube-blr-lxc:  # CT 181
          ansible_host: 10.10.0.81
          ansible_port: 22
        dispatcharr-blr-lxc:  # CT 188
          ansible_host: 10.10.0.88
          ansible_port: 22
        # AdGuard querylog (playbooks/logging.yml --tags alloy_adguard_b / _a). Alloy only.
        adguard-blr-lxc-b:  # CT 155 (AdGuard B, vmbr1)
          ansible_host: 10.10.0.55
          ansible_port: 22
        adguard-blr-lxc:  # CT 153 (AdGuard A)
          ansible_host: 10.10.0.53
          ansible_port: 22
        # Wave 5 (logging.yml --tags alloy_wave5; metrics.yml --tags
        # metrics_wave5). NetBird routers 151/150 are NetTit's: Alloy only.
        blr-nb-lxc-b:  # CT 151 (NetBird router B, vmbr1)
          ansible_host: 10.10.0.51
          ansible_port: 22
        blr-nb-lxc:  # CT 150 (NetBird router A)
          ansible_host: 10.10.0.50
          ansible_port: 22
        unbound-blr-lxc:  # CT 154
          ansible_host: 10.10.0.54
          ansible_port: 22
        adguardsync-blr-lxc:  # CT 156
          ansible_host: 10.10.0.56
          ansible_port: 22
        # CT 250. playbooks/caddy.yml targets this host. site.yml does not.
        # Port 22: Debian 13 Caddy guest, not an ansible-playbooks harden.
        caddy-blr-lxc:
          ansible_host: 10.10.0.250
          ansible_port: 22
    # Proxmox Backup Server. playbooks/pbs.yml targets this group. site.yml does not.
    pbs:
      hosts:
        astarothrinascimento:
          ansible_host: 10.10.0.25
          ansible_port: 22
          ansible_user: grokops
          # grokaudit/grokops keys: group_vars/all/bot_ssh_keys.yml (role bot_ssh_keys).
    # Oracle VPS. playbooks/host-backups.yml (role gremory_pull_source). Public SSH only;
    # never install NetBird on it.
    gremory:
      hosts:
        vnic-gremory:
          ansible_host: 163.192.206.150
          ansible_user: gremory
          # gremory_pull_source_pubkey: set in gitignored host_vars
    # Flint main router (GL-BE9300, 10.10.0.1). playbooks/flint.yml targets
    # this group. No Python on the device; that play uses raw only.
    # Commented here so a copied example + playbooks/ping.yml (hosts: all)
    # does not try ansible.builtin.ping against Flint. Uncomment in the
    # gitignored inventory/blr.yml before running playbooks/flint.yml.
    # flint:
    #   hosts:
    #     flint-main:
    #       ansible_host: 10.10.0.1
    #       ansible_port: 22
    #       ansible_user: root
    #       ansible_python_interpreter: /bin/false

    # Console root autologin. Empty until the gitignored copy lists the
    # approved guests (CT 175, CT 182, CT 250). CT 176 is not a member.
    # See ansible/README.md.
    console_autologin:
      hosts: {}
    # Read-only grokaudit account (playbooks/grokaudit.yml). Empty until the
    # gitignored copy lists guests. CT 161, 169, 176 and 183 are refused.
    grokaudit_lxc:
      hosts: {}
