}
}
http://*.alehpineda.com {
 bind 10.10.0.250 10.10.0.251
 route {
 @on251 expression `{http.request.local.host} == "10.10.0.251"`
 handle @on251 {
 @family_ok host jellyfin.alehpineda.com seerr.alehpineda.com searxng.alehpineda.com romm.alehpineda.com navidrome.alehpineda.com audiobookshelf.alehpineda.com bentopdf.alehpineda.com linkwarden.alehpineda.com
 handle @family_ok {
 redir https://{host}{uri} 308
 }
 handle {
 abort
 }
 }
 @family_denied host jellyfin.alehpineda.com seerr.alehpineda.com searxng.alehpineda.com romm.alehpineda.com navidrome.alehpineda.com audiobookshelf.alehpineda.com bentopdf.alehpineda.com linkwarden.alehpineda.com
 handle @family_denied {
 abort
 }
 handle {
 redir https://{host}{uri} 308
 }
 }
}
