			transport http {
				local_address 10.10.0.250
				network_proxy none
			}
		}
	}
	@wazuh host wazuh.alehpineda.com
	handle @wazuh {
		reverse_proxy https://10.10.0.90:443 {
			transport http {
				tls_insecure_skip_verify
				local_address 10.10.0.250
				network_proxy none
			}
		}
	}
	@homepage host homepage.alehpineda.com
	handle @homepage {
		reverse_proxy http://10.10.0.91:3000 {
			transport http {
				local_address 10.10.0.250
				network_proxy none
			}
		}
	}
	@homarr host homarr.alehpineda.com
	handle @homarr {
